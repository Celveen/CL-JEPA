__pycache__
*.pyc
figures
*outputs*
data/*
# stream target files and the seen-shape probe are small and needed to run the continual experiments
!data/cont_streams/
data/cont_streams/smoke_*
!data/seen_probe/
wandb
checkpoints
*.slurm
*.sh
# env/wall/data is a source package (WallDatasetConfig, layouts), not a dataset dir
!env/wall/data/
!env/wall/data/*.py

# experiment reports and packaged zips stay local; only the paper figures (reports/figs/*.pdf) are tracked
reports/*
!reports/figs/
reports/figs/*
!reports/figs/*.pdf
dist
!scripts/cont_frozen_chunks.sh
